# TrackSkill AI — development task runner.
# Prerequisite: Docker Compose v2. Raw equivalents are documented in README.md.

COMPOSE ?= docker compose
API := api
WEB := web

.DEFAULT_GOAL := help
.PHONY: help dev down logs seed test lint format typecheck migrate revision api-shell web-shell db-shell clean

help: ## Show available targets
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-12s\033[0m %s\n", $$1, $$2}'

dev: ## Start Postgres + API + Web with hot reload
	$(COMPOSE) up --build

down: ## Stop the stack (data volumes are kept)
	$(COMPOSE) down

logs: ## Follow API and Web logs
	$(COMPOSE) logs -f $(API) $(WEB)

seed: ## Seed demo data inside the API container (stack must be up)
	$(COMPOSE) exec $(API) python -m app.seed

test: ## Run API tests and web typecheck + lint (stack must be up)
	$(COMPOSE) exec -T $(API) pytest
	$(COMPOSE) exec -T $(WEB) npm run typecheck
	$(COMPOSE) exec -T $(WEB) npm run lint

lint: ## Ruff (API) and ESLint (Web)
	$(COMPOSE) exec -T $(API) ruff check app tests
	$(COMPOSE) exec -T $(WEB) npm run lint

format: ## Ruff format (API) and Prettier (Web)
	$(COMPOSE) exec -T $(API) ruff format app tests
	$(COMPOSE) exec -T $(WEB) npm run format

typecheck: ## TypeScript check for the web app
	$(COMPOSE) exec -T $(WEB) npm run typecheck

migrate: ## Apply database migrations
	$(COMPOSE) exec $(API) alembic upgrade head

revision: ## Autogenerated migration: make revision m="add consent table"
	$(COMPOSE) exec $(API) alembic revision --autogenerate -m "$(m)"

api-shell: ## Shell inside the API container
	$(COMPOSE) exec $(API) bash

web-shell: ## Shell inside the Web container
	$(COMPOSE) exec $(WEB) sh

db-shell: ## psql inside the database container
	$(COMPOSE) exec db psql -U $${POSTGRES_USER:-trackskill} -d $${POSTGRES_DB:-trackskill}

clean: ## Stop the stack and delete volumes (DESTROYS local data)
	$(COMPOSE) down -v
