# ──────────────────────────────────────────────────────────────────────────────
# TrackSkill AI — local development environment
# Copy this file to .env:  cp .env.example .env
# Docker Compose auto-loads .env for variable interpolation.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=trackskill
POSTGRES_PASSWORD=trackskill_dev_password
POSTGRES_DB=trackskill

# SQLAlchemy URL used when running the API OUTSIDE Docker.
# Inside Docker Compose this URL is built from the POSTGRES_* values above
# with the service host "db", so it always points at the database container.
DATABASE_URL=postgresql+psycopg://trackskill:trackskill_dev_password@localhost:5432/trackskill

# ── API ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# JWT signing secret (access + refresh tokens). HS256 needs >= 32 bytes.
# Generate a real one for anything beyond local development:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-0123456789abcdef

# ── Auth ──────────────────────────────────────────────────────────────────────
# GET /auth/demo-accounts is served only while DEMO_MODE=true. Never enable
# it (or the demo password) in production.
DEMO_MODE=true
DEMO_PASSWORD=Demo@1234
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# ── AI module ─────────────────────────────────────────────────────────────────
# true (default): deterministic hashed n-gram embedder — no model download,
#   runs on any laptop.
# false: sentence-transformers all-MiniLM-L6-v2 (semantic matching) —
#   requires: pip install sentence-transformers
USE_LIGHT_NLP=true

# ── Tracer engine ─────────────────────────────────────────────────────────────
# simulated = local demo gateways (default); twilio|meta select stubs that
# raise until real integrations land.
TRACER_PROVIDER=simulated
SCHEDULER_ENABLED=true
TRACER_INTERVAL_SECONDS=300
TRACER_EXPIRY_DAYS=14
TRACER_MAX_ATTEMPTS=3

# ── Web Push (Phase 10) ───────────────────────────────────────────────────────
# VAPID identity for encrypted browser notifications. Leave both keys empty in
# local development — the API generates a P-256 pair on first run and stores it
# in vapid-keys.json (gitignored). For production, generate a real pair:
#   python -m app.core.vapid
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Where the generated keys are persisted when env vars are empty.
VAPID_KEYS_FILE=vapid-keys.json
# Contact identity embedded in VAPID claims (must be mailto: for prod).
PUSH_SUBJECT=mailto:demo@trackskill.in

# ── Web ───────────────────────────────────────────────────────────────────────
# Browser-side base URLs. Read by apps/web/src/lib/api.ts.
# After changing these, restart the web dev server (they are inlined per page
# compile).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
